  "info": {
    "description": "本地推荐与管理演示。未配置 PostgreSQL：会话和推荐结果只保存在当前进程。受控 CPU bundle 可发布；真实 R06 研究模型尚未在线接入。",
    "title": "EvoRec Demo API",
    "version": "0.0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/bundles/{bundle_id}/publish": {
      "post": {
        "operationId": "publish_bundle_api_v1_admin_bundles__bundle_id__publish_post",
        "parameters": [
          {
            "in": "path",
            "name": "bundle_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Bundle Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Admin-Token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Admin-Token"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublicationInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Publish Bundle",
        "tags": [
          "admin"
        ]
      }
    },
