{
  "$defs": {
    "CatalogItem": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 10000,
          "title": "Description",
          "type": "string"
        },
        "image_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        },
        "item_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Item Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "title",
        "category"
      ],
      "title": "CatalogItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "format": "uuid",
      "title": "Batch Id",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/CatalogItem"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "batch_id",
    "items"
  ],
  "title": "CatalogImportInput",
  "type": "object"
}
