# Local PostgreSQL development only. Copy to .env and replace the password;
# .env is ignored and must never be committed.
EVOREC_DATABASE_URL=postgresql://evorec:change-me@127.0.0.1:5432/evorec

# Optional local management. Generate a unique secret of at least 32 characters;
# never commit its real value or expose the service on a public interface.
EVOREC_ADMIN_TOKEN=
EVOREC_BUNDLE_ROOT=artifacts/bundles
