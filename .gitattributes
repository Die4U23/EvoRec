* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.pdf binary

# Preserve generated research evidence byte-for-byte, including recorded hashes.
docs/experiments/** -text whitespace=cr-at-eol
docs/blog/assets/** -text whitespace=cr-at-eol
docs/validation/** -text whitespace=cr-at-eol
# Matplotlib path data and captured test output can contain intentional whitespace.
docs/experiments/**/*.svg whitespace=-blank-at-eol,cr-at-eol
docs/blog/assets/**/*.svg whitespace=-blank-at-eol,cr-at-eol
docs/validation/*.xml whitespace=-blank-at-eol,cr-at-eol
